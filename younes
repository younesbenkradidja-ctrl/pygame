# Button class
class Button:
    def __init__(self, x, y, width, height, text, color, hover_color):
        self.rect = pygame.Rect(x, y, width, height)
        self.text = text
        self.color = color
        self.hover_color = hover_color
        self.is_hovered = False
        
    def draw(self, surface):
        color = self.hover_color if self.is_hovered else self.color
        pygame.draw.rect(surface, color, self.rect, border_radius=10)
        pygame.draw.rect(surface, COLORS["dark_blue"], self.rect, 2, border_radius=10)
        
        text_surf = body_font.render(self.text, True, COLORS["white"])
        text_rect = text_surf.get_rect(center=self.rect.center)
        surface.blit(text_surf, text_rect)
        
    def check_hover(self, pos):
        self.is_hovered = self.rect.collidepoint(pos)
        
    def check_click(self, pos, event):
        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            return self.rect.collidepoint(pos)
        return False

# Content box with scroll
class ScrollBox:
    def __init__(self, x, y, width, height):
        self.rect = pygame.Rect(x, y, width, height)
        self.content_height = 0
        self.scroll_y = 0
        self.max_scroll = 0
        
    def set_content_height(self, height):
        self.content_height = height
        self.max_scroll = max(0, height - self.rect.height)
        
    def scroll(self, amount):
        self.scroll_y = max(0, min(self.max_scroll, self.scroll_y + amount))
        
    def draw(self, surface, content_surface):
        # Create a subsurface for the scroll box
        subsurface = surface.subsurface(self.rect)
        subsurface.fill(COLORS["white"])
        
        # Draw the content
        content_rect = pygame.Rect(0, -self.scroll_y, self.rect.width, self.content_height)
        subsurface.blit(content_surface, content_rect)
        
        # Draw border
        pygame.draw.rect(subsurface, COLORS["dark_blue"], (0, 0, self.rect.width, self.rect.height), 2, border_radius=5)
        
        # Draw scrollbar if needed
        if self.content_height > self.rect.height:
            scrollbar_height = max(30, self.rect.height * (self.rect.height / self.content_height))
            scrollbar_pos = (self.scroll_y / self.max_scroll) * (self.rect.height - scrollbar_height)
            
            pygame.draw.rect(
                subsurface, 
                COLORS["light_blue"], 
                (self.rect.width - 10, scrollbar_pos, 8, scrollbar_height),
                border_radius=4
            )

