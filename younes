# Main loop
clock = pygame.time.Clock()
running = True

while running:
    mouse_pos = pygame.mouse.get_pos()
    
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        
        if event.type == pygame.MOUSEBUTTONDOWN:
            if generate_button.check_click(mouse_pos, event):
                pdf_path = create_pdf("Mer_et_Soleil_Concept.pdf")
                print(f"PDF generated at: {os.path.abspath(pdf_path)}")
            
            # Handle scrolling
            if scroll_box.rect.collidepoint(mouse_pos):
                if event.button == 4:  # Scroll up
                    scroll_box.scroll(-20)
                elif event.button == 5:  # Scroll down
                    scroll_box.scroll(20)
    
    # Update button state
    generate_button.check_hover(mouse_pos)
    
    # Draw everything
    screen.fill(COLORS["background"])
    
    # Draw header
    pygame.draw.rect(screen, COLORS["dark_blue"], (0, 0, WIDTH, 80))
    title = title_font.render("Mer & Soleil - PDF Generator", True, COLORS["white"])
    screen.blit(title, (WIDTH//2 - title.get_width()//2, 25))
    
    # Draw instructions
    instructions = body_font.render("Preview of the PDF content. Scroll to see more. Click to generate the PDF.", True, COLORS["text"])
    screen.blit(instructions, (WIDTH//2 - instructions.get_width()//2, 90))
    
    # Draw scroll box with content
    scroll_box.draw(screen, content_surface)
    
    # Draw button
    generate_button.draw(screen)
    
    # Draw footer
    pygame.draw.rect(screen, COLORS["sand"], (0, HEIGHT - 30, WIDTH, 30))
    footer_text = small_font.render("© 2023 Mer & Soleil Restaurant Concept", True, COLORS["dark_blue"])
    screen.blit(footer_text, (WIDTH//2 - footer_text.get_width()//2, HEIGHT - 25))
    
    pygame.display.flip()
    clock.tick(60)

pygame.quit()
sys.exit()
